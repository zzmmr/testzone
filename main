local Players = cloneref(game:GetService("Players"))
local UserInputService = cloneref(game:GetService("UserInputService"))
local RunService = cloneref(game:GetService("RunService"))
local GuiService = cloneref(game:GetService("GuiService"))
local Stats = game:GetService("Stats")
local CurrentCamera = workspace.CurrentCamera
local Player = Players.LocalPlayer

local GRAVITY = workspace.Gravity or 196.2

local Connections = {}
local Pressed = false

-- ============================================================
-- PREDICTION STATE (smoothed to prevent jitter)
-- ============================================================
local SmoothedVelocities = {}       -- [userId] = Vector3 (exponential moving average)
local PreviousPositions = {}        -- [userId] = Vector3 (for velocity calc)
local PositionTimestamps = {}       -- [userId] = number (os.clock)
local SmoothedPredictions = {}      -- [userId] = Vector3 (lerped prediction position)
local VELOCITY_SMOOTH_ALPHA = 0.3   -- How fast velocity adapts (0-1, lower = smoother)
local PREDICTION_LERP_SPEED = 8     -- How fast prediction position converges
local VELOCITY_DEADZONE = 1.5       -- Ignore movement below this speed (studs/sec)
local MAX_VELOCITY = 80             -- Clamp unrealistic velocities (teleports, lag)

local Aimflow = {
    Settings = {
        Smoothness = 20,            -- 0 = instant, 1-100 = smoother
        Radius = 300,
        ShowCircle = true,
        CircleColor = Color3.fromRGB(255, 255, 255),
        Enabled = true,
        Bodypart = "HumanoidRootPart",
        UseMouseMove = true,

        -- ============================================================
        -- PREDICTION SETTINGS
        -- ============================================================
        Prediction = {
            Enabled = false,            -- Master toggle
            TriggerDelay = 0.5,         -- Seconds between click and shot
            ProjectileSpeed = 0,        -- 0 = hitscan, >0 = projectile units/sec
            PingCompensation = true,    -- Include ping for hitscan
            UseGravity = false,         -- Bullet drop for projectiles
            MaxPrediction = 50,         -- Maximum prediction lead in studs
        },
    },

    isEnemy = function(Enemy)
        return true
    end,

    isAlive = function(Enemy)
        local Character = Enemy.Character
        local Humanoid = Character and Character:FindFirstChild("Humanoid")
        return Humanoid and Humanoid.Health > 0
    end
}

-- ============================================================
-- UTILITY
-- ============================================================

local function getActiveMouseLocation()
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        return CurrentCamera.ViewportSize / 2
    end

    local mousePos = UserInputService:GetMouseLocation()
    local ignoreInset = GuiService:GetGuiInset()
    return Vector2.new(mousePos.X, mousePos.Y - ignoreInset.Y)
end

local function getPing()
    local success, pingMs = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return (success and pingMs or 0) / 1000
end

-- ============================================================
-- STABILIZED VELOCITY TRACKING
-- Solves the teleportation problem by:
-- 1. Smoothing velocity with exponential moving average
-- 2. Applying a deadzone so tiny movements don't trigger prediction
-- 3. Clamping unrealistic velocities from lag/teleports
-- ============================================================

local function getSmoothedVelocity(plr, rootPart)
    local userId = plr.UserId
    local currentPos = rootPart.Position
    local now = os.clock()

    -- Calculate raw velocity from position delta
    local rawVelocity = Vector3.zero
    local prevPos = PreviousPositions[userId]
    local prevTime = PositionTimestamps[userId]

    if prevPos and prevTime then
        local dt = now - prevTime
        if dt > 0.001 and dt < 0.5 then  -- Ignore huge time gaps (respawn/teleport)
            rawVelocity = (currentPos - prevPos) / dt

            -- Clamp to max realistic velocity
            if rawVelocity.Magnitude > MAX_VELOCITY then
                rawVelocity = rawVelocity.Unit * MAX_VELOCITY
            end
        end
    end

    -- Update position history
    PreviousPositions[userId] = currentPos
    PositionTimestamps[userId] = now

    -- Exponential moving average for smooth velocity
    local prevSmoothed = SmoothedVelocities[userId]
    if prevSmoothed then
        local alpha = VELOCITY_SMOOTH_ALPHA
        local newSmoothed = prevSmoothed + (rawVelocity - prevSmoothed) * alpha
        SmoothedVelocities[userId] = newSmoothed
        return newSmoothed
    else
        SmoothedVelocities[userId] = rawVelocity
        return rawVelocity
    end
end

-- ============================================================
-- PREDICTED POSITION CALCULATION
-- ============================================================

local function calculatePredictedPosition(currentPos, velocity, shooterPos, settings)
    local ping = settings.PingCompensation and getPing() or 0
    local triggerDelay = settings.TriggerDelay or 0
    local projectileSpeed = settings.ProjectileSpeed or 0

    -- Build total delay
    local totalDelay = triggerDelay
    if projectileSpeed > 0 then
        local distance = (currentPos - shooterPos).Magnitude
        totalDelay = totalDelay + (distance / projectileSpeed)

        -- Iterative refinement
        for _ = 1, 3 do
            local rough = currentPos + velocity * totalDelay
            local newDist = (rough - shooterPos).Magnitude
            totalDelay = triggerDelay + (newDist / projectileSpeed)
        end
    else
        totalDelay = totalDelay + ping + 0.03
    end

    -- Predict future position
    local predicted = currentPos + velocity * totalDelay

    -- Gravity compensation (projectile arc, NOT during trigger delay)
    if settings.UseGravity and projectileSpeed > 0 then
        local flightTime = totalDelay - triggerDelay
        predicted = predicted - Vector3.new(0, 0.5 * GRAVITY * flightTime * flightTime, 0)
    end

    -- Clamp prediction distance
    local offset = (predicted - currentPos).Magnitude
    local maxPred = settings.MaxPrediction or 50
    if offset > maxPred then
        predicted = currentPos + (predicted - currentPos).Unit * maxPred
    end

    return predicted, totalDelay
end

-- ============================================================
-- KEYBIND (unchanged)
-- ============================================================

function Aimflow:SetKeybind(keybind)
    for i, c in Connections do
        c:Disconnect()
        Connections[i] = nil
    end
    Pressed = false

    table.insert(Connections, UserInputService.InputBegan:Connect(function(input)
        if (input.UserInputType ~= keybind and input.KeyCode ~= keybind) or not Aimflow.Settings.Enabled then
            return
        end
        Pressed = true

        -- Clear prediction state on fresh press
        SmoothedVelocities = {}
        SmoothedPredictions = {}
        PreviousPositions = {}
    end))

    table.insert(Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= keybind and input.KeyCode ~= keybind then return end
        Pressed = false
    end))
end

-- ============================================================
-- TARGET SELECTION (with stabilized prediction)
-- ============================================================

function getClosest()
    local mouseLocation = getActiveMouseLocation()
    local closestPlayer = nil
    local closestCharacter = nil
    local closestTargetPos = nil     -- The actual position to aim at
    local closestDistance = math.huge

    local settings = Aimflow.Settings.Prediction
    local usePrediction = settings.Enabled
    local shooterPos = CurrentCamera.CFrame.Position
    local now = os.clock()

    for _, plr in Players:GetPlayers() do
        if plr == Player then continue end
        if not Aimflow.isEnemy(plr) or not Aimflow.isAlive(plr) then continue end

        local character = plr.Character
        if not character then continue end

        local rootPart = character:FindFirstChild(Aimflow.Settings.Bodypart)
        if not rootPart then continue end

        local currentPos = rootPart.Position
        local aimPosition = currentPos  -- Default: aim at current position

        -- ============================================================
        -- STABILIZED PREDICTION
        -- ============================================================
        if usePrediction then
            local velocity = getSmoothedVelocity(plr, rootPart)
            local speed = velocity.Magnitude

            -- Only predict if target is actually moving
            if speed > VELOCITY_DEADZONE then
                local predicted, _ = calculatePredictedPosition(
                    currentPos, velocity, shooterPos, settings
                )

                -- Lerp the prediction display position for smooth transitions
                -- This prevents the "teleporting" effect when velocity changes
                local prevPrediction = SmoothedPredictions[plr.UserId]
                if prevPrediction then
                    local lerpFactor = math.min(PREDICTION_LERP_SPEED * 
                        (now - (PositionTimestamps[plr.UserId] or now)), 1)
                    predicted = prevPrediction + (predicted - prevPrediction) * lerpFactor
                end
                SmoothedPredictions[plr.UserId] = predicted

                aimPosition = predicted
            else
                -- Target is basically still — reset prediction smoothing
                SmoothedPredictions[plr.UserId] = nil
            end
        end

        -- ============================================================
        -- SCREEN CONVERSION
        -- ============================================================
        local screenPoint, onScreen = CurrentCamera:WorldToViewportPoint(aimPosition)

        -- Fallback: if prediction pushed off-screen, use current position
        if not onScreen and usePrediction then
            screenPoint, onScreen = CurrentCamera:WorldToViewportPoint(currentPos)
            aimPosition = currentPos
        end

        if not onScreen then continue end

        local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
        local distance = (screenPos - mouseLocation).Magnitude

        if distance > Aimflow.Settings.Radius then continue end

        if distance < closestDistance then
            closestDistance = distance
            closestPlayer = plr
            closestCharacter = character
            closestTargetPos = aimPosition
        end
    end

    return closestCharacter, closestPlayer, closestTargetPos
end

-- ============================================================
-- MAIN AIM LOOP
-- ============================================================

RunService.RenderStepped:Connect(function(deltaTime)
    if not Pressed or not Aimflow.Settings.Enabled then return end

    local closestCharacter, _, predictedPos = getClosest()
    if not closestCharacter then return end

    -- Use predicted position if available, otherwise use body part directly
    local targetPosition = predictedPos
    if not targetPosition then
        local bodyPart = closestCharacter:FindFirstChild(Aimflow.Settings.Bodypart)
        if not bodyPart then return end
        targetPosition = bodyPart.Position
    end

    if Aimflow.Settings.UseMouseMove then
        -- ============================================================
        -- PROPORTIONAL CONTROLLER (fixed smoothness)
        -- ============================================================
        local screenPoint, onScreen = CurrentCamera:WorldToViewportPoint(targetPosition)
        if not onScreen then return end

        local mousePos = UserInputService:GetMouseLocation()
        local deltaX = screenPoint.X - mousePos.X
        local deltaY = screenPoint.Y - mousePos.Y
        local distance = math.sqrt(deltaX * deltaX + deltaY * deltaY)

        if distance < 0.5 then return end  -- Already on target

        -- Convert smoothness setting to response speed
        local smoothness = math.clamp(Aimflow.Settings.Smoothness, 0, 100)
        local responseSpeed
        if smoothness <= 0 then
            responseSpeed = 1.0
        else
            -- Exponential curve: smoothness=1 → ~75%, smoothness=20 → ~30%, smoothness=100 → ~2%
            responseSpeed = math.exp(-smoothness / 25) * 0.8 + 0.02
        end

        -- Calculate step as percentage of remaining distance
        local stepX = deltaX * responseSpeed
        local stepY = deltaY * responseSpeed

        -- Minimum step to prevent aim from stalling near target
        local stepMagnitude = math.sqrt(stepX * stepX + stepY * stepY)
        local minStep = 0.5
        if stepMagnitude < minStep and distance > minStep then
            local ratio = minStep / stepMagnitude
            stepX = stepX * ratio
            stepY = stepY * ratio
        end

        -- Never overshoot
        if math.abs(stepX) > math.abs(deltaX) then stepX = deltaX end
        if math.abs(stepY) > math.abs(deltaY) then stepY = deltaY end

        -- Frame-rate independence (normalize to 60fps)
        local dtScale = math.min(deltaTime * 60, 2)
        stepX = stepX * dtScale
        stepY = stepY * dtScale

        if mousemoverel then
            mousemoverel(stepX, stepY)
        end
    else
        -- Camera CFrame aim (lerp method)
        if Aimflow.Settings.Smoothness > 0 then
            local scaleFactor = math.max(1, Aimflow.Settings.Smoothness / 10)
            local targetRotation = CFrame.lookAt(CurrentCamera.CFrame.Position, targetPosition)
            CurrentCamera.CFrame = CurrentCamera.CFrame:Lerp(targetRotation, 1 / scaleFactor)
        else
            CurrentCamera.CFrame = CFrame.lookAt(CurrentCamera.CFrame.Position, targetPosition)
        end
    end
end)

-- ============================================================
-- FOV CIRCLE (unchanged)
-- ============================================================

task.spawn(function()
    local FOVCircle = Drawing.new("Circle")
    FOVCircle.Thickness = 2
    FOVCircle.Filled = false

    while true do
        FOVCircle.Visible = Aimflow.Settings.ShowCircle

        if not Aimflow.Settings.ShowCircle then
            task.wait(0.1)
            continue
        end

        FOVCircle.Radius = Aimflow.Settings.Radius
        FOVCircle.Color = Aimflow.Settings.CircleColor

        local baseMouse = getActiveMouseLocation()
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
            local ignoreInset = GuiService:GetGuiInset()
            FOVCircle.Position = Vector2.new(baseMouse.X, baseMouse.Y + ignoreInset.Y)
        else
            FOVCircle.Position = baseMouse
        end

        task.wait()
    end
end)

return Aimflow
