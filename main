local Players = cloneref(game:GetService("Players"))
local UserInputService = cloneref(game:GetService("UserInputService"))
local RunService = cloneref(game:GetService("RunService"))
local GuiService = cloneref(game:GetService("GuiService"))
local Stats = game:GetService("Stats")
local CurrentCamera = workspace.CurrentCamera
local Player = Players.LocalPlayer

local GRAVITY = workspace.Gravity or 196.2

local Connections = {}
local Pressed = false

-- Target lock to prevent flicking between targets
local LastTarget = nil
local LastTargetTime = 0
local TARGET_LOCK_TIME = 0.15  -- Stay on same target for at least 150ms

local Aimflow = {
    Settings = {
        Smoothness = 20,
        Radius = 300,
        ShowCircle = true,
        CircleColor = Color3.fromRGB(255, 255, 255),
        Enabled = true,
        Bodypart = "HumanoidRootPart",
        UseMouseMove = true,

        Prediction = {
            Enabled = false,
            TriggerDelay = 0.5,
            ProjectileSpeed = 0,
            PingCompensation = true,
            UseGravity = false,
            MaxPrediction = 50,
        },
    },

    isEnemy = function(Enemy)
        return true
    end,

    isAlive = function(Enemy)
        local Character = Enemy.Character
        local Humanoid = Character and Character:FindFirstChild("Humanoid")
        return Humanoid and Humanoid.Health > 0
    end
}

-- ============================================================
-- MOUSE MOVEMENT SAFETY CONSTANTS
-- ============================================================
local MAX_STEP_PER_FRAME = 25     -- Absolute max pixels to move in one frame
local SNAP_THRESHOLD = 400        -- If delta exceeds this, snap instantly
local SCREEN_EDGE_MARGIN = 50     -- Stay this many pixels from screen edge

-- ============================================================
-- UTILITY
-- ============================================================

local function getActiveMouseLocation()
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        return CurrentCamera.ViewportSize / 2
    end

    local mousePos = UserInputService:GetMouseLocation()
    local ignoreInset = GuiService:GetGuiInset()
    return Vector2.new(mousePos.X, mousePos.Y - ignoreInset.Y)
end

local function getPing()
    local success, pingMs = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return (success and pingMs or 0) / 1000
end

-- ============================================================
-- CLAMP TARGET TO SCREEN (prevent off-screen aiming)
-- ============================================================

local function clampToScreen(worldPosition)
    local screenPoint, onScreen = CurrentCamera:WorldToViewportPoint(worldPosition)
    local viewport = CurrentCamera.ViewportSize

    if not onScreen then
        -- Clamp to nearest screen edge
        local clampedX = math.clamp(screenPoint.X, SCREEN_EDGE_MARGIN, viewport.X - SCREEN_EDGE_MARGIN)
        local clampedY = math.clamp(screenPoint.Y, SCREEN_EDGE_MARGIN, viewport.Y - SCREEN_EDGE_MARGIN)

        -- Convert back to world position at the clamped screen point
        local ray = CurrentCamera:ViewportPointToRay(clampedX, clampedY)
        local depth = (worldPosition - CurrentCamera.CFrame.Position).Magnitude
        return ray.Origin + ray.Direction * depth, true
    end

    -- Clamp even on-screen positions away from the absolute edge
    local clampedX = math.clamp(screenPoint.X, SCREEN_EDGE_MARGIN, viewport.X - SCREEN_EDGE_MARGIN)
    local clampedY = math.clamp(screenPoint.Y, SCREEN_EDGE_MARGIN, viewport.Y - SCREEN_EDGE_MARGIN)

    if clampedX ~= screenPoint.X or clampedY ~= screenPoint.Y then
        local ray = CurrentCamera:ViewportPointToRay(clampedX, clampedY)
        local depth = (worldPosition - CurrentCamera.CFrame.Position).Magnitude
        return ray.Origin + ray.Direction * depth, true
    end

    return worldPosition, onScreen
end

-- ============================================================
-- SIMPLE PREDICTION
-- ============================================================

local function getPredictedPosition(rootPart, shooterPos, settings)
    local velocity = Vector3.zero
    if rootPart:IsA("BasePart") then
        velocity = rootPart.AssemblyLinearVelocity or rootPart.Velocity or Vector3.zero
    end

    if velocity.Magnitude < 0.5 then
        local humanoid = rootPart.Parent and rootPart.Parent:FindFirstChild("Humanoid")
        if humanoid and humanoid.MoveDirection.Magnitude > 0 then
            velocity = humanoid.MoveDirection * humanoid.WalkSpeed
        end
    end

    if velocity.Magnitude < 1 then
        return rootPart.Position
    end

    local currentPos = rootPart.Position
    local distance = (currentPos - shooterPos).Magnitude
    local ping = settings.PingCompensation and getPing() or 0
    local totalDelay = settings.TriggerDelay or 0

    if (settings.ProjectileSpeed or 0) > 0 then
        totalDelay = totalDelay + (distance / settings.ProjectileSpeed)
    else
        totalDelay = totalDelay + ping + 0.03
    end

    local predicted = currentPos + velocity * totalDelay

    if settings.UseGravity and (settings.ProjectileSpeed or 0) > 0 then
        local flightTime = totalDelay - (settings.TriggerDelay or 0)
        predicted = predicted - Vector3.new(0, 0.5 * GRAVITY * flightTime * flightTime, 0)
    end

    local offset = (predicted - currentPos).Magnitude
    local maxPred = settings.MaxPrediction or 50
    if offset > maxPred then
        predicted = currentPos + (predicted - currentPos).Unit * maxPred
    end

    return predicted
end

-- ============================================================
-- KEYBIND
-- ============================================================

function Aimflow:SetKeybind(keybind)
    for i, c in Connections do
        c:Disconnect()
        Connections[i] = nil
    end
    Pressed = false
    LastTarget = nil

    table.insert(Connections, UserInputService.InputBegan:Connect(function(input)
        if (input.UserInputType ~= keybind and input.KeyCode ~= keybind) or not Aimflow.Settings.Enabled then
            return
        end
        Pressed = true
        LastTarget = nil  -- Reset lock on fresh press
    end))

    table.insert(Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= keybind and input.KeyCode ~= keybind then return end
        Pressed = false
        LastTarget = nil
    end))
end

-- ============================================================
-- TARGET SELECTION
-- ============================================================

function getClosest()
    local mouseLocation = getActiveMouseLocation()
    local closestCharacter = nil
    local closestTargetPos = nil
    local closestDistance = math.huge
    local closestWasLocked = false

    local predSettings = Aimflow.Settings.Prediction
    local shooterPos = CurrentCamera.CFrame.Position
    local now = os.clock()

    -- Check if we should maintain target lock
    local maintainLock = LastTarget and (now - LastTargetTime) < TARGET_LOCK_TIME

    for _, plr in Players:GetPlayers() do
        if plr == Player then continue end
        if not Aimflow.isEnemy(plr) or not Aimflow.isAlive(plr) then continue end

        local character = plr.Character
        if not character then continue end

        local rootPart = character:FindFirstChild(Aimflow.Settings.Bodypart)
        if not rootPart then continue end

        -- Get aim position
        local aimPosition
        if predSettings.Enabled then
            aimPosition = getPredictedPosition(rootPart, shooterPos, predSettings)
        else
            aimPosition = rootPart.Position
        end

        -- Clamp to screen bounds
        aimPosition, _ = clampToScreen(aimPosition)

        -- Convert to screen
        local screenPoint, onScreen = CurrentCamera:WorldToViewportPoint(aimPosition)

        if not onScreen and predSettings.Enabled then
            -- Fallback to current position
            local clampedCurrent, currentOnScreen = clampToScreen(rootPart.Position)
            screenPoint, onScreen = CurrentCamera:WorldToViewportPoint(clampedCurrent)
            if onScreen then
                aimPosition = clampedCurrent
            end
        end

        if not onScreen then continue end

        local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
        local distance = (screenPos - mouseLocation).Magnitude

        if distance > Aimflow.Settings.Radius then continue end

        -- If maintaining lock, prefer the locked target even if slightly farther
        local isLockedTarget = (character == LastTarget)
        local effectiveDistance = distance
        if maintainLock and isLockedTarget then
            effectiveDistance = distance * 0.7  -- Bias toward locked target
        end

        if effectiveDistance < closestDistance then
            closestDistance = effectiveDistance
            closestCharacter = character
            closestTargetPos = aimPosition
            closestWasLocked = isLockedTarget
        end
    end

    -- Update target lock
    if closestCharacter and closestCharacter ~= LastTarget then
        if not maintainLock or closestWasLocked then
            LastTarget = closestCharacter
            LastTargetTime = now
        end
    elseif closestCharacter == LastTarget then
        LastTargetTime = now  -- Refresh lock
    end

    return closestCharacter, closestTargetPos
end

-- ============================================================
-- SAFE MOUSE MOVEMENT
-- Prevents the mouse from flying off-screen
-- ============================================================

local function safeMouseMove(deltaX, deltaY, distance, deltaTime)
    -- SAFETY 1: If delta is absurdly large (half the screen), snap instantly
    local viewport = CurrentCamera.ViewportSize
    local maxScreenDim = math.max(viewport.X, viewport.Y)
    
    if distance > SNAP_THRESHOLD then
        -- Something went wrong—snap to avoid wild movement
        if mousemoverel then
            mousemoverel(deltaX, deltaY)
        end
        return
    end

    -- SAFETY 2: Non-linear scaling for large deltas
    -- Small deltas: proportional movement
    -- Large deltas: logarithmic dampening to prevent flying
    local smoothness = math.clamp(Aimflow.Settings.Smoothness, 0, 100)
    local responseSpeed

    if smoothness <= 0 then
        -- Instant snap, but still cap it
        local maxStep = MAX_STEP_PER_FRAME * 4  -- Allow faster snapping when smoothness=0
        if distance > maxStep then
            local ratio = maxStep / distance
            deltaX = deltaX * ratio
            deltaY = deltaY * ratio
        end
        if mousemoverel then
            mousemoverel(deltaX, deltaY)
        end
        return
    end

    -- Calculate base response speed
    responseSpeed = math.exp(-smoothness / 25) * 0.8 + 0.02

    -- Apply response curve
    local stepX = deltaX * responseSpeed
    local stepY = deltaY * responseSpeed

    -- SAFETY 3: Hard cap on maximum step per frame
    local stepMagnitude = math.sqrt(stepX * stepX + stepY * stepY)
    if stepMagnitude > MAX_STEP_PER_FRAME then
        local ratio = MAX_STEP_PER_FRAME / stepMagnitude
        stepX = stepX * ratio
        stepY = stepY * ratio
    end

    -- SAFETY 4: Never overshoot the target
    if math.abs(stepX) > math.abs(deltaX) then stepX = deltaX end
    if math.abs(stepY) > math.abs(deltaY) then stepY = deltaY end

    -- SAFETY 5: Minimum step to prevent stall (but only if we're not at the cap)
    local minStep = 0.5
    local finalMagnitude = math.sqrt(stepX * stepX + stepY * stepY)
    if finalMagnitude < minStep and distance > minStep then
        local ratio = minStep / finalMagnitude
        stepX = stepX * ratio
        stepY = stepY * ratio
        -- Re-check cap after min step boost
        local boostedMag = math.sqrt(stepX * stepX + stepY * stepY)
        if boostedMag > MAX_STEP_PER_FRAME then
            local ratio2 = MAX_STEP_PER_FRAME / boostedMag
            stepX = stepX * ratio2
            stepY = stepY * ratio2
        end
    end

    -- SAFETY 6: Frame-rate independence (normalize to 60fps, cap at 2x)
    local dtScale = math.min(deltaTime * 60, 2)
    stepX = stepX * dtScale
    stepY = stepY * dtScale

    -- SAFETY 7: Final hard cap after all adjustments
    local finalMagnitude2 = math.sqrt(stepX * stepX + stepY * stepY)
    if finalMagnitude2 > MAX_STEP_PER_FRAME * 2 then
        local ratio = (MAX_STEP_PER_FRAME * 2) / finalMagnitude2
        stepX = stepX * ratio
        stepY = stepY * ratio
    end

    -- SAFETY 8: Ensure we're not moving the mouse off-screen
    local currentMouse = UserInputService:GetMouseLocation()
    local newX = currentMouse.X + stepX
    local newY = currentMouse.Y + stepY

    if newX < SCREEN_EDGE_MARGIN then
        stepX = SCREEN_EDGE_MARGIN - currentMouse.X
    elseif newX > viewport.X - SCREEN_EDGE_MARGIN then
        stepX = (viewport.X - SCREEN_EDGE_MARGIN) - currentMouse.X
    end

    if newY < SCREEN_EDGE_MARGIN then
        stepY = SCREEN_EDGE_MARGIN - currentMouse.Y
    elseif newY > viewport.Y - SCREEN_EDGE_MARGIN then
        stepY = (viewport.Y - SCREEN_EDGE_MARGIN) - currentMouse.Y
    end

    if mousemoverel then
        mousemoverel(stepX, stepY)
    end
end

-- ============================================================
-- MAIN AIM LOOP
-- ============================================================

RunService.RenderStepped:Connect(function(deltaTime)
    if not Pressed or not Aimflow.Settings.Enabled then return end

    local closestCharacter, targetPos = getClosest()
    if not closestCharacter then return end

    if not targetPos then
        local bodyPart = closestCharacter:FindFirstChild(Aimflow.Settings.Bodypart)
        if not bodyPart then return end
        targetPos = bodyPart.Position
    end

    if Aimflow.Settings.UseMouseMove then
        local screenPoint, onScreen = CurrentCamera:WorldToViewportPoint(targetPos)
        if not onScreen then return end

        local mousePos = UserInputService:GetMouseLocation()
        local deltaX = screenPoint.X - mousePos.X
        local deltaY = screenPoint.Y - mousePos.Y
        local distance = math.sqrt(deltaX * deltaX + deltaY * deltaY)

        if distance < 0.5 then return end

        safeMouseMove(deltaX, deltaY, distance, deltaTime)
    else
        if Aimflow.Settings.Smoothness > 0 then
            local scaleFactor = math.max(1, Aimflow.Settings.Smoothness / 10)
            local targetRotation = CFrame.lookAt(CurrentCamera.CFrame.Position, targetPos)
            CurrentCamera.CFrame = CurrentCamera.CFrame:Lerp(targetRotation, 1 / scaleFactor)
        else
            CurrentCamera.CFrame = CFrame.lookAt(CurrentCamera.CFrame.Position, targetPos)
        end
    end
end)

-- ============================================================
-- FOV CIRCLE
-- ============================================================

task.spawn(function()
    local FOVCircle = Drawing.new("Circle")
    FOVCircle.Thickness = 2
    FOVCircle.Filled = false

    while true do
        FOVCircle.Visible = Aimflow.Settings.ShowCircle

        if not Aimflow.Settings.ShowCircle then
            task.wait(0.1)
            continue
        end

        FOVCircle.Radius = Aimflow.Settings.Radius
        FOVCircle.Color = Aimflow.Settings.CircleColor

        local baseMouse = getActiveMouseLocation()
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
            local ignoreInset = GuiService:GetGuiInset()
            FOVCircle.Position = Vector2.new(baseMouse.X, baseMouse.Y + ignoreInset.Y)
        else
            FOVCircle.Position = baseMouse
        end

        task.wait()
    end
end)

return Aimflow
