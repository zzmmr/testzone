local Players = cloneref(game:GetService("Players"))
local UserInputService = cloneref(game:GetService("UserInputService"))
local RunService = cloneref(game:GetService("RunService"))
local GuiService = cloneref(game:GetService("GuiService"))
local Stats = game:GetService("Stats")
local CurrentCamera = workspace.CurrentCamera
local Player = Players.LocalPlayer

local GRAVITY = workspace.Gravity or 196.2

local Connections = {}
local Pressed = false
local VelocityHistory = {}
local VelocityTimestamps = {}
local LockedTarget = nil
local LockStartTime = 0

-- ============================================================
-- ANTI-FLICKER STATE
-- ============================================================
local LastAimTarget = nil          -- Previous frame's target character
local LastAimTargetTime = 0       -- When we locked onto it
local TARGET_LOCK_DURATION = 0.15 -- Stay on same target for 150ms
local SmoothedAimPosition = nil   -- Lerped prediction output
local AIM_LERP_SPEED = 12         -- How fast aim position converges

local Aimflow = {
    Settings = {
        Smoothness = 20,
        Radius = 300,
        ShowCircle = true,
        CircleColor = Color3.fromRGB(255, 255, 255),
        Enabled = true,
        Bodypart = "HumanoidRootPart",
        UseMouseMove = true,

        Prediction = {
            Enabled = false,
            TriggerDelay = 0.5,
            ProjectileSpeed = 0,
            PingCompensation = true,
            UseGravity = false,
            MaxPrediction = 50,
            ShowDebug = false,
            ContinuousLock = false,
        },
    },

    isEnemy = function(Enemy)
        return true
    end,

    isAlive = function(Enemy)
        local Character = Enemy.Character
        local Humanoid = Character and Character:FindFirstChild("Humanoid")
        return Humanoid and Humanoid.Health > 0
    end
}

-- ============================================================
-- UTILITY
-- ============================================================

local function getActiveMouseLocation()
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        return CurrentCamera.ViewportSize / 2
    end
    local mousePos = UserInputService:GetMouseLocation()
    local ignoreInset = GuiService:GetGuiInset()
    return Vector2.new(mousePos.X, mousePos.Y - ignoreInset.Y)
end

local function getPing()
    local success, ping = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return (success and ping or 0) / 1000
end

local function getPlayerVelocity(plr, character)
    local rootPart = character:FindFirstChild(Aimflow.Settings.Bodypart)
    if not rootPart then return Vector3.zero, Vector3.zero end

    local currentVelocity = Vector3.zero
    if rootPart:IsA("BasePart") then
        currentVelocity = rootPart.AssemblyLinearVelocity or rootPart.Velocity or Vector3.zero
    end

    if currentVelocity.Magnitude < 0.5 then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid and humanoid.MoveDirection.Magnitude > 0 then
            currentVelocity = humanoid.MoveDirection * humanoid.WalkSpeed
        end
    end

    local prevVelocity = VelocityHistory[plr.UserId] or currentVelocity
    local prevTime = VelocityTimestamps[plr.UserId] or (os.clock() - 0.1)
    local deltaTime = math.max(os.clock() - prevTime, 0.001)
    local acceleration = (currentVelocity - prevVelocity) / deltaTime

    local maxAccel = 100
    if acceleration.Magnitude > maxAccel then
        acceleration = acceleration.Unit * maxAccel
    end

    VelocityHistory[plr.UserId] = currentVelocity
    VelocityTimestamps[plr.UserId] = os.clock()

    return currentVelocity, acceleration
end

local function calculatePredictedPosition(currentPos, velocity, acceleration, shooterPos, settings)
    local ping = settings.PingCompensation and getPing() or 0
    local triggerDelay = settings.TriggerDelay or 0
    local projectileSpeed = settings.ProjectileSpeed or 0
    local totalDelay = triggerDelay

    if projectileSpeed > 0 then
        local distance = (currentPos - shooterPos).Magnitude
        totalDelay = triggerDelay + (distance / projectileSpeed)

        for _ = 1, 3 do
            local roughPrediction = currentPos
                + velocity * totalDelay
                + 0.5 * acceleration * totalDelay * totalDelay
            local newDistance = (roughPrediction - shooterPos).Magnitude
            totalDelay = triggerDelay + (newDistance / projectileSpeed)
        end
    else
        totalDelay = triggerDelay + ping + 0.03
    end

    local predictedPosition = currentPos
        + (velocity * totalDelay)
        + (0.5 * acceleration * totalDelay * totalDelay)

    if settings.UseGravity and projectileSpeed > 0 then
        local flightTime = totalDelay - triggerDelay
        predictedPosition = predictedPosition
            - Vector3.new(0, 0.5 * GRAVITY * flightTime * flightTime, 0)
    end

    local predictionMagnitude = (predictedPosition - currentPos).Magnitude
    local maxPrediction = settings.MaxPrediction or 50
    if predictionMagnitude > maxPrediction then
        predictedPosition = currentPos
            + (predictedPosition - currentPos).Unit * maxPrediction
    end

    return predictedPosition, totalDelay
end

-- ============================================================
-- KEYBIND
-- ============================================================

function Aimflow:SetKeybind(keybind)
    for i, c in Connections do
        c:Disconnect()
        Connections[i] = nil
    end
    Pressed = false
    LastAimTarget = nil
    SmoothedAimPosition = nil

    table.insert(Connections, UserInputService.InputBegan:Connect(function(input)
        if (input.UserInputType ~= keybind and input.KeyCode ~= keybind) or not Aimflow.Settings.Enabled then
            return
        end
        Pressed = true
        LastAimTarget = nil
        SmoothedAimPosition = nil

        if Aimflow.Settings.Prediction.Enabled and Aimflow.Settings.Prediction.ContinuousLock then
            LockedTarget = nil
            LockStartTime = 0
        end
    end))

    table.insert(Connections, UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= keybind and input.KeyCode ~= keybind then return end
        Pressed = false
        LastAimTarget = nil
        SmoothedAimPosition = nil
        LockedTarget = nil
    end))
end

-- ============================================================
-- TARGET SELECTION (with anti-flicker lock)
-- ============================================================

function getClosest()
    local mouseLocation = getActiveMouseLocation()
    local closestCharacter = nil
    local closestPredictedPosition = nil
    local closestCurrentPosition = nil
    local closestDistance = math.huge

    local settings = Aimflow.Settings.Prediction
    local usePrediction = settings.Enabled
    local shooterPos = CurrentCamera.CFrame.Position
    local now = os.clock()

    -- Determine if we're still in the lock window
    local maintainLock = LastAimTarget
        and (now - LastAimTargetTime) < TARGET_LOCK_DURATION

    for _, plr in Players:GetPlayers() do
        if plr == Player then continue end
        if not Aimflow.isEnemy(plr) or not Aimflow.isAlive(plr) then continue end

        local character = plr.Character
        if not character then continue end

        local rootPart = character:FindFirstChild(Aimflow.Settings.Bodypart)
        if not rootPart then continue end

        local targetPosition = rootPart.Position
        local velocity, acceleration = Vector3.zero, Vector3.zero

        if usePrediction then
            velocity, acceleration = getPlayerVelocity(plr, character)

            if velocity.Magnitude > 1 or acceleration.Magnitude > 1 then
                local predicted, _ = calculatePredictedPosition(
                    targetPosition, velocity, acceleration, shooterPos, settings
                )
                targetPosition = predicted
            end
        end

        local screenPoint, onScreen = CurrentCamera:WorldToViewportPoint(targetPosition)

        if not onScreen and usePrediction and velocity.Magnitude > 0 then
            screenPoint, onScreen = CurrentCamera:WorldToViewportPoint(rootPart.Position)
            targetPosition = rootPart.Position
        end

        if not onScreen then continue end

        local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
        local distance = (screenPos - mouseLocation).Magnitude

        local effectiveRadius = Aimflow.Settings.Radius
        if usePrediction then
            local speedFactor = 1 + (velocity.Magnitude / 150)
            effectiveRadius = Aimflow.Settings.Radius * speedFactor
        end

        if distance > effectiveRadius then continue end

        -- ============================================================
        -- ANTI-FLICKER: Bias toward the currently locked target
        -- A new target must be SIGNIFICANTLY closer to steal the lock
        -- ============================================================
        local effectiveDistance = distance
        if maintainLock and character == LastAimTarget then
            -- Current target gets a 40% distance reduction
            effectiveDistance = distance * 0.6
        elseif maintainLock and character ~= LastAimTarget then
            -- New targets need to be 30% closer to break the lock
            effectiveDistance = distance * 1.3
        end

        if effectiveDistance < closestDistance then
            closestDistance = effectiveDistance
            closestCharacter = character
            closestPredictedPosition = targetPosition
            closestCurrentPosition = rootPart.Position
        end
    end

    -- Update lock state
    if closestCharacter then
        if closestCharacter ~= LastAimTarget then
            -- Only switch if lock expired or new target is genuinely better
            if not maintainLock then
                LastAimTarget = closestCharacter
                LastAimTargetTime = now
                SmoothedAimPosition = nil  -- Reset smoothing on target switch
            end
        else
            LastAimTargetTime = now  -- Refresh lock
        end
    else
        LastAimTarget = nil
        SmoothedAimPosition = nil
    end

    return closestCharacter, closestPredictedPosition
end

-- ============================================================
-- MAIN AIM LOOP
-- ============================================================

RunService.RenderStepped:Connect(function(deltaTime)
    if not Pressed or not Aimflow.Settings.Enabled then return end

    local settings = Aimflow.Settings.Prediction
    local rawTargetPosition = nil
    local targetCharacter = nil

    -- ============================================================
    -- CONTINUOUS LOCK (trigger delay tracking)
    -- ============================================================
    if settings.Enabled and settings.ContinuousLock and LockedTarget then
        local elapsed = os.clock() - LockStartTime
        local triggerDelay = settings.TriggerDelay or 0.5

        if elapsed < triggerDelay then
            local character = LockedTarget.Character
            if character then
                targetCharacter = character
                local rootPart = character:FindFirstChild(Aimflow.Settings.Bodypart)
                if rootPart then
                    local velocity, acceleration = getPlayerVelocity(LockedTarget, character)
                    local remaining = triggerDelay - elapsed
                    rawTargetPosition = rootPart.Position
                        + velocity * remaining
                        + 0.5 * acceleration * remaining * remaining
                end
            else
                LockedTarget = nil
            end
        else
            LockedTarget = nil
        end
    end

    -- ============================================================
    -- NORMAL TARGET ACQUISITION
    -- ============================================================
    if not rawTargetPosition then
        local closestCharacter, predictedPos = getClosest()

        if not closestCharacter then return end
        targetCharacter = closestCharacter

        if settings.Enabled and settings.ContinuousLock then
            -- getClosest returns closestCharacter (first return value)
            -- We need the player for the lock
            -- Fix: pass the player through getClosest or find it here
        end

        if predictedPos then
            rawTargetPosition = predictedPos
        else
            local bodyPart = closestCharacter:FindFirstChild(Aimflow.Settings.Bodypart)
            if bodyPart then
                rawTargetPosition = bodyPart.Position
            else
                return
            end
        end
    end

    if not rawTargetPosition then return end

    -- ============================================================
    -- ANTI-FLICKER: Smooth the aim position itself
    -- Instead of jumping to the new prediction every frame,
    -- lerp toward it. This stops the mouse from jittering when
    -- the prediction moves slightly frame-to-frame.
    -- ============================================================
    local targetPosition = rawTargetPosition
    if SmoothedAimPosition then
        local lerpFactor = math.min(AIM_LERP_SPEED * deltaTime, 1.0)
        targetPosition = SmoothedAimPosition:Lerp(rawTargetPosition, lerpFactor)
    end
    SmoothedAimPosition = targetPosition

    -- ============================================================
    -- APPLY AIM
    -- ============================================================
    if Aimflow.Settings.UseMouseMove then
        local screenPoint, onScreen = CurrentCamera:WorldToViewportPoint(targetPosition)
        if not onScreen then return end

        local mousePos = UserInputService:GetMouseLocation()
        local deltaX = screenPoint.X - mousePos.X
        local deltaY = screenPoint.Y - mousePos.Y
        local distance = math.sqrt(deltaX * deltaX + deltaY * deltaY)

        if distance < 1 then return end

        -- ============================================================
        -- PROPORTIONAL CONTROLLER WITH DISTANCE BOOST
        -- ============================================================
        local smoothness = math.clamp(Aimflow.Settings.Smoothness, 0, 100)
        local responseSpeed

        if smoothness <= 0 then
            if mousemoverel then
                mousemoverel(deltaX, deltaY)
            end
            return
        end

        responseSpeed = math.exp(-smoothness / 30) * 0.85 + 0.03

        -- Distance boost: move faster when far from target
        if distance > 150 then
            responseSpeed = responseSpeed * 2.0
        elseif distance > 75 then
            responseSpeed = responseSpeed * 1.5
        elseif distance > 30 then
            responseSpeed = responseSpeed * 1.25
        end

        local stepX = deltaX * responseSpeed
        local stepY = deltaY * responseSpeed

        -- Hard cap per frame
        local MAX_STEP = 50
        local stepMag = math.sqrt(stepX * stepX + stepY * stepY)
        if stepMag > MAX_STEP then
            local ratio = MAX_STEP / stepMag
            stepX = stepX * ratio
            stepY = stepY * ratio
        end

        -- Never overshoot
        if math.abs(stepX) > math.abs(deltaX) then stepX = deltaX end
        if math.abs(stepY) > math.abs(deltaY) then stepY = deltaY end

        -- Minimum step
        local minStep = 1.0
        stepMag = math.sqrt(stepX * stepX + stepY * stepY)
        if stepMag < minStep and distance > minStep then
            local ratio = minStep / stepMag
            stepX = stepX * ratio
            stepY = stepY * ratio
        end

        -- Frame-rate scaling
        local dtScale = math.min(deltaTime * 60, 2)
        stepX = stepX * dtScale
        stepY = stepY * dtScale

        if mousemoverel then
            mousemoverel(stepX, stepY)
        end
    else
        if Aimflow.Settings.Smoothness > 0 then
            local scaleFactor = math.max(1, Aimflow.Settings.Smoothness / 10)
            local targetRotation = CFrame.lookAt(CurrentCamera.CFrame.Position, targetPosition)
            CurrentCamera.CFrame = CurrentCamera.CFrame:Lerp(targetRotation, 1 / scaleFactor)
        else
            CurrentCamera.CFrame = CFrame.lookAt(CurrentCamera.CFrame.Position, targetPosition)
        end
    end
end)

-- ============================================================
-- FOV CIRCLE
-- ============================================================

task.spawn(function()
    local FOVCircle = Drawing.new("Circle")
    FOVCircle.Thickness = 2
    FOVCircle.Filled = false

    while true do
        FOVCircle.Visible = Aimflow.Settings.ShowCircle

        if not Aimflow.Settings.ShowCircle then
            task.wait(0.1)
            continue
        end

        FOVCircle.Radius = Aimflow.Settings.Radius
        FOVCircle.Color = Aimflow.Settings.CircleColor

        local baseMouse = getActiveMouseLocation()
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
            local ignoreInset = GuiService:GetGuiInset()
            FOVCircle.Position = Vector2.new(baseMouse.X, baseMouse.Y + ignoreInset.Y)
        else
            FOVCircle.Position = baseMouse
        end

        task.wait()
    end
end)

return Aimflow
