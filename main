-- ============================================================
-- getClosestPlayerToMouse WITH VELOCITY PREDICTION
-- Predicts where the target will be when the bullet arrives
-- ============================================================

-- Configuration (add these to your Options/Settings)
-- Options.projectileSpeed = 0        -- 0 = hitscan, >0 = projectile units/sec
-- Options.useGravityComp = false     -- Arc compensation for projectiles
-- Options.pingCompensation = true    -- Use ping in time-of-flight for hitscan

local GRAVITY = workspace.Gravity or 196.2  -- Default Roblox gravity

local function getClosestPlayerToMouse(teamTable)
    local mouseLocation = Services.UserInputService:GetMouseLocation() 
        or (workspace.CurrentCamera.ViewportSize / 2)

    local camera = workspace.CurrentCamera
    local closestPlayer = nil
    local closestCharacter = nil
    local closestPredictedPosition = nil  -- NEW: return predicted world position
    local closestDistance = math.huge
    local closestScreenPoint = nil

    -- Get local player's ping for hitscan prediction
    local ping = 0
    if Options.pingCompensation then
        ping = (game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() or 0) / 1000
    end

    -- Get projectile speed (0 = hitscan)
    local projectileSpeed = Options.projectileSpeed or 0
    local useGravityComp = Options.useGravityComp or false
    local fovRadius = Options.fovSlider.Value

    for _, plr in Services.Players:GetPlayers() do
        if plr == Player or not plr:GetAttribute("Alive") then 
            continue 
        end
        
        if not teamTable[Visual.GetTeam(plr)] then 
            continue 
        end

        local character = plr.Character
        if not character then continue end

        local humanoid = character:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then continue end

        -- ============================================================
        -- VELOCITY EXTRACTION
        -- Priority: RootPart AssemblyLinearVelocity > Humanoid.MoveDirection
        -- ============================================================
        local velocity = Vector3.zero
        
        -- Method 1: Use actual physics velocity (most accurate, includes knockback/jumping/falling)
        if rootPart:IsA("BasePart") then
            velocity = rootPart.AssemblyLinearVelocity or rootPart.Velocity or Vector3.zero
        end
        
        -- Method 2: Fallback to Humanoid movement direction
        if velocity.Magnitude < 0.1 and humanoid.MoveDirection.Magnitude > 0 then
            velocity = humanoid.MoveDirection * humanoid.WalkSpeed
        end
        
        -- If target is essentially stationary, skip prediction
        local targetSpeed = velocity.Magnitude
        
        -- ============================================================
        -- CURRENT POSITION
        -- ============================================================
        local currentPosition = rootPart.Position
        
        -- ============================================================
        -- TIME-TO-TARGET CALCULATION
        -- ============================================================
        local timeToTarget = 0
        
        -- Distance from camera (or local player) to target
        local localRoot = Player.Character 
            and Player.Character:FindFirstChild("HumanoidRootPart")
        local shooterPosition = localRoot 
            and localRoot.Position 
            or camera.CFrame.Position
        
        local distanceToTarget = (currentPosition - shooterPosition).Magnitude
        
        if projectileSpeed > 0 then
            -- PROJECTILE: time = distance / speed
            timeToTarget = distanceToTarget / projectileSpeed
            
            -- Iterative prediction: recalculate with predicted distance
            -- (The predicted position changes the distance, which changes time-to-target)
            for _ = 1, 3 do  -- 3 iterations is usually enough
                local predictedPos = currentPosition + velocity * timeToTarget
                if useGravityComp then
                    -- Apply gravity drop: d = 0.5 * g * t^2
                    predictedPos = predictedPos - Vector3.new(0, 0.5 * GRAVITY * timeToTarget * timeToTarget, 0)
                end
                local newDistance = (predictedPos - shooterPosition).Magnitude
                timeToTarget = newDistance / projectileSpeed
            end
        else
            -- HITSCAN: use ping + reaction time
            timeToTarget = ping + 0.03  -- 30ms for processing/human reaction
        end
        
        -- ============================================================
        -- PREDICTED POSITION
        -- ============================================================
        local predictedPosition = currentPosition + (velocity * timeToTarget)
        
        -- Optional gravity compensation for projectile arc
        if useGravityComp and projectileSpeed > 0 then
            predictedPosition = predictedPosition 
                - Vector3.new(0, 0.5 * GRAVITY * timeToTarget * timeToTarget, 0)
        end
        
        -- ============================================================
        -- CONVERT PREDICTED POSITION TO SCREEN
        -- ============================================================
        local screenPoint, onScreen = camera:WorldToViewportPoint(predictedPosition)
        
        -- If prediction puts target off-screen, fall back to current position
        if not onScreen and targetSpeed > 0 then
            screenPoint, onScreen = camera:WorldToViewportPoint(currentPosition)
            predictedPosition = currentPosition
        end
        
        if not onScreen then continue end

        local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
        local distance = (screenPos - mouseLocation).Magnitude

        -- FOV check
        if distance > fovRadius then continue end

        -- ============================================================
        -- BONUS: Velocity-based FOV scaling
        -- Faster targets get a slightly larger effective FOV
        -- because prediction is less reliable at high speeds
        -- ============================================================
        local speedFactor = 1 + (targetSpeed / 200)  -- Adjust divisor as needed
        local adjustedFov = fovRadius * speedFactor
        
        if distance < closestDistance then
            closestDistance = distance
            closestPlayer = plr
            closestCharacter = character
            closestPredictedPosition = predictedPosition
            closestScreenPoint = screenPos
        end
    end
    
    return closestPlayer, closestCharacter, closestPredictedPosition
end

-- ============================================================
-- OPTIONAL: Enhanced version with acceleration prediction
-- For targets that are actively changing velocity (dodging)
-- ============================================================

local function getClosestPlayerToMouseWithAcceleration(teamTable)
    local mouseLocation = Services.UserInputService:GetMouseLocation() 
        or (workspace.CurrentCamera.ViewportSize / 2)

    local camera = workspace.CurrentCamera
    local closestPlayer = nil
    local closestCharacter = nil
    local closestPredictedPosition = nil
    local closestDistance = math.huge

    local ping = 0
    if Options.pingCompensation then
        ping = (game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() or 0) / 1000
    end

    local projectileSpeed = Options.projectileSpeed or 0
    local fovRadius = Options.fovSlider.Value

    -- Store previous velocities for acceleration calculation
    -- In production, use a table keyed by player UserId
    if not shared.VelocityHistory then
        shared.VelocityHistory = {}
    end

    for _, plr in Services.Players:GetPlayers() do
        if plr == Player or not plr:GetAttribute("Alive") then continue end
        if not teamTable[Visual.GetTeam(plr)] then continue end

        local character = plr.Character
        if not character then continue end

        local humanoid = character:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then continue end

        -- Get current velocity
        local currentVelocity = Vector3.zero
        if rootPart:IsA("BasePart") then
            currentVelocity = rootPart.AssemblyLinearVelocity or rootPart.Velocity or Vector3.zero
        end
        if currentVelocity.Magnitude < 0.1 and humanoid.MoveDirection.Magnitude > 0 then
            currentVelocity = humanoid.MoveDirection * humanoid.WalkSpeed
        end

        -- Calculate acceleration from velocity history
        local previousVelocity = shared.VelocityHistory[plr.UserId] or currentVelocity
        local acceleration = (currentVelocity - previousVelocity) / 0.1  -- Assuming ~10 FPS updates
        shared.VelocityHistory[plr.UserId] = currentVelocity

        local currentPosition = rootPart.Position
        local shooterPosition = Player.Character 
            and Player.Character:FindFirstChild("HumanoidRootPart")
        local shooterPos = shooterPosition 
            and shooterPosition.Position 
            or camera.CFrame.Position

        local distanceToTarget = (currentPosition - shooterPos).Magnitude
        local timeToTarget = projectileSpeed > 0 
            and (distanceToTarget / projectileSpeed) 
            or (ping + 0.03)

        -- Prediction WITH acceleration:
        -- predictedPos = pos + v*t + 0.5*a*t^2
        local predictedPosition = currentPosition 
            + (currentVelocity * timeToTarget) 
            + (0.5 * acceleration * timeToTarget * timeToTarget)

        -- Clamp prediction — don't predict more than 50 studs ahead
        local predictionDelta = (predictedPosition - currentPosition).Magnitude
        if predictionDelta > 50 then
            predictedPosition = currentPosition 
                + (predictedPosition - currentPosition).Unit * 50
        end

        local screenPoint, onScreen = camera:WorldToViewportPoint(predictedPosition)
        if not onScreen then
            screenPoint, onScreen = camera:WorldToViewportPoint(currentPosition)
            predictedPosition = currentPosition
        end
        if not onScreen then continue end

        local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
        local distance = (screenPos - mouseLocation).Magnitude

        if distance > fovRadius then continue end

        if distance < closestDistance then
            closestDistance = distance
            closestPlayer = plr
            closestCharacter = character
            closestPredictedPosition = predictedPosition
        end
    end

    return closestPlayer, closestCharacter, closestPredictedPosition
end

-- ============================================================
-- USAGE: Aim at predicted position
-- ============================================================

-- In your aimbot loop:
local targetPlayer, targetCharacter, predictedWorldPos = getClosestPlayerToMouse(teamTable)

if targetCharacter and predictedWorldPos then
    -- Aim at the PREDICTED position, not the current position
    local aimCFrame = CFrame.new(
        workspace.CurrentCamera.CFrame.Position, 
        predictedWorldPos
    )
    
    -- Apply aim (depends on your method)
    -- Method 1: Direct CFrame override
    workspace.CurrentCamera.CFrame = aimCFrame
    
    -- Method 2: Smooth aim (lerp)
    -- local currentCFrame = workspace.CurrentCamera.CFrame
    -- local smoothCFrame = currentCFrame:Lerp(aimCFrame, Options.aimSmoothness)
    -- workspace.CurrentCamera.CFrame = smoothCFrame
    
    -- Method 3: Mouse move (for mouse-based aim)
    -- local screenPoint = workspace.CurrentCamera:WorldToViewportPoint(predictedWorldPos)
    -- local targetScreen = Vector2.new(screenPoint.X, screenPoint.Y)
    -- local mousePos = Services.UserInputService:GetMouseLocation()
    -- local delta = targetScreen - mousePos
    -- mousemoverel(delta.X, delta.Y)
end

-- ============================================================
-- VISUAL: Draw prediction line (debug)
-- ============================================================

-- Optional: Draw where the prediction is aiming
if targetCharacter and predictedWorldPos then
    -- Draw line from target's current position to predicted position
    local currentPos = targetCharacter.HumanoidRootPart.Position
    local line = Drawing.new("Line")
    line.From = currentPos
    line.To = predictedWorldPos
    line.Color = Color3.new(1, 0, 0)
    line.Thickness = 2
    line.Visible = true
    -- Store to cleanup next frame
    shared.PredictionLine = line
end
